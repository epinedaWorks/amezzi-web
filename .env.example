# Copie este archivo a .env.local y complete los valores.
# El correo sale por Amazon SES (us-west-1) con las credenciales de AWS del entorno:
# en local, el perfil de ~/.aws; en el servidor, el rol de la instancia.
AWS_PROFILE=reux
AMEZZI_AWS_REGION=us-west-1
# Uno o varios correos separados por coma que reciben las solicitudes
TEAM_EMAIL=
